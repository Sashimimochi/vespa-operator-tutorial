<?xml version="1.0" encoding="utf-8" ?>
<!-- Vespa サービス設定ファイル / Vespa services configuration
     ノード数は hosts.xml のエイリアスと一致させること
     Node counts must match the aliases defined in hosts.xml -->
<services version="1.0">

  <admin version="2.0">
    <!-- コンフィグサーバー (ZooKeeper クォーラム: 3 台) -->
    <!-- Config servers (ZooKeeper quorum: 3 nodes) -->
    <configservers>
      <configserver hostalias="node0" />
      <configserver hostalias="node1" />
      <configserver hostalias="node2" />
    </configservers>
    <!-- クラスターコントローラー / Cluster controllers -->
    <cluster-controllers>
      <!-- jvm-options はローカルテスト用のメモリ削減設定。本番では削除すること -->
      <!-- jvm-options shrink memory for local testing — remove for production -->
      <cluster-controller hostalias="node0" jvm-options="-Xms32M -Xmx64M" />
      <cluster-controller hostalias="node1" jvm-options="-Xms32M -Xmx64M" />
      <cluster-controller hostalias="node2" jvm-options="-Xms32M -Xmx64M" />
    </cluster-controllers>
    <!-- スロブロク (サービスディスカバリー) / Slobrok (service discovery) -->
    <slobroks>
      <slobrok hostalias="node0" />
      <slobrok hostalias="node1" />
      <slobrok hostalias="node2" />
    </slobroks>
    <adminserver hostalias="node3" />
  </admin>

  <!-- フィードコンテナ (データ投入用) / Feed container cluster (for document ingestion) -->
  <container id="feed" version="1.0">
    <document-api />
    <document-processing />
    <nodes>
      <!-- jvm options はローカルテスト用 / jvm options for local testing only — remove for production -->
      <jvm options="-Xms32M -Xmx128M" />
      <node hostalias="node4" />
      <node hostalias="node5" />
    </nodes>
  </container>

  <!-- クエリコンテナ (検索用) / Query container cluster (for search) -->
  <container id="query" version="1.0">
    <search />
    <nodes>
      <!-- jvm options はローカルテスト用 / jvm options for local testing only — remove for production -->
      <jvm options="-Xms32M -Xmx128M" />
      <node hostalias="node6" />
      <node hostalias="node7" />
    </nodes>
  </container>

  <!-- コンテントクラスター (データ保存・冗長化) / Content cluster (data storage with redundancy) -->
  <content id="music" version="1.0">
    <!-- 冗長度 2: データを 2 ノードに複製する / Redundancy 2: replicate data across 2 nodes -->
    <min-redundancy>2</min-redundancy>
    <documents>
      <document type="music" mode="index" />
      <document-processing cluster="feed" />
    </documents>
    <nodes>
      <node hostalias="node8" distribution-key="0" />
      <node hostalias="node9" distribution-key="1" />
    </nodes>
  </content>

</services>
